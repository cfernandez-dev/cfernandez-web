{
  "version": 2,
  "name": "cristhian-fernandez-portfolio",
  "headers": [
    {
      "source": "/(.*\\.(css|js|png|jpg|jpeg|gif|ico|svg|pdf))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sections/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}