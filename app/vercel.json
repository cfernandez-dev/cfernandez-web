{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "sections/*.html",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!styles\\.css|script\\.js|sections/).*)",
      "destination": "/index.html"
    }
  ]
}